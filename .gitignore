# ==========================================
# Environment & Secrets (NEVER COMMIT)
# ==========================================
.env
.env.*
!.env.example
*.env
backend/.env
frontend/.env*.local

# ==========================================
# Python & Backend Exclusions
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
.venv/
build/
develop-eggs/
dist/
downloads/
eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.ruff_cache/

# Databases & Storage
*.db
*.sqlite
*.sqlite3
backend/smartdoc.db
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep

# ==========================================
# Node.js & Frontend Exclusions
# ==========================================
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js / TypeScript build info
*.tsbuildinfo
frontend/next-env.d.ts

# ==========================================
# IDE & Operating System Files
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Internal Documentation / Prompt Files
docs/

# Editor directories
.vscode/
.idea/
*.swp
*.swo
