# SmartDoc Environment Configuration Example
PROJECT_NAME="SmartDoc API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="smartdoc_dev_secret_key_change_in_production"

# LLM Provider Selection ("ollama" or "claude")
LLM_PROVIDER=ollama

# Ollama Local LLM Settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TEMPERATURE=0.1

# Anthropic Claude API Settings (Optional if LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=

# Processing Limits
MAX_FILE_SIZE_MB=100
CHUNK_SIZE_TOKENS=1500
CHUNK_OVERLAP_TOKENS=150

# Web Search Fallback Settings
WEB_SEARCH_ENABLED=true
TAVILY_API_KEY=
